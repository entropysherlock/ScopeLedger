def MonochromaticQuantumGraph.allEqualList : {N D : ℕ} →
  (MonochromaticQuantumGraph.V N → Fin D) → List (MonochromaticQuantumGraph.V N) → Prop :=
fun {N D} ι L => List.IsChain (fun v w => ι v = ι w) L
