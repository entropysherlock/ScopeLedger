def MonochromaticQuantumGraph.vertices : (N : ℕ) → List (MonochromaticQuantumGraph.V N) :=
fun x =>
  Nat.brecOn x fun x f =>
    (match (motive := (x : ℕ) → Nat.below x → List (MonochromaticQuantumGraph.V x)) x with
      | 0 => fun x => []
      | N.succ => fun x => 0 :: List.map Fin.succ x.1)
      f
