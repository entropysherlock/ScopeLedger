def SL003FC.Erdos522.SL003.targetProp.{u_1} : Prop :=
∀ {Ω : Type u_1} [inst : MeasureTheory.MeasureSpace Ω] [MeasureTheory.IsProbabilityMeasure MeasureTheory.volume]
  {n : ℕ},
  (1 : ℕ) ≤ n →
    ∀ (f : SL003FC.Erdos522.KacCoefficients {(0 : ℂ), (1 : ℂ)} Ω),
      MeasureTheory.volume
          {ω | Filter.Tendsto (fun n => (2 : ℝ) * ↑(f.numRootsInUnitDisk n ω) / ↑n) Filter.atTop (nhds (1 : ℝ))} =
        (1 : ENNReal)
